# Router bind
ROUTER_HOST=0.0.0.0
ROUTER_PORT=9000

# Public hostname (what jobs should register as)
PUBLIC_HOSTNAME=127.0.0.1


# Auth
# AUTH_MODE=password  -> single shared secret (the historical behaviour)
# AUTH_MODE=ldap      -> FreeIPA bind + group-based roles
AUTH_MODE=password

# In ldap mode this becomes the break-glass admin account. Keep it enabled:
# an IPA outage must not lock you out of the scheduler you need to fix it.
AUTH_PASSWORD=changeme
# LOCAL_ADMIN_ENABLED=true
# AUTH_SECRET_KEY=  # Optional: set for stable sessions across restarts
# AUTH_SESSION_MAX_AGE_SECONDS=86400  # 24h default


# --- LDAP / FreeIPA (only used when AUTH_MODE=ldap) ---
# LDAP_URL=ldaps://ipa.example.de
# LDAP_USER_DN_TEMPLATE=uid={username},cn=users,cn=accounts,dc=example,dc=de
# Only needed if the directory does not expose memberOf on the user entry:
# LDAP_GROUP_BASE_DN=cn=groups,cn=accounts,dc=example,dc=de
# LDAP_START_TLS=false
# LDAP_TIMEOUT_SECONDS=5
# LDAP_GROUP_CACHE_SECONDS=300

# --- Roles (LDAP group names) ---
# ADMIN_GROUPS=llm-admins
# Empty means any authenticated identity may create bookings.
# USER_GROUPS=
# Per-pool stewards as "pool:group,pool:group". Superseded by cluster.yaml.
# POOL_OPERATORS=llm-dedicated:llm-gpu-team

# --- Cluster backend ---
#   slurm_rest  slurmrestd over JWT — no Slurm binaries, munge or bind-mounts.
#               This is what lets the router run anywhere.
#   slurm_cli   subprocess; must run on a host with the Slurm binaries.
#               Still needed for `sbatch --test-only` start estimates, which
#               have no REST equivalent.
#   local       in-memory fake, for tests and laptop development.
CLUSTER_BACKEND=slurm_cli

# --- slurmrestd (CLUSTER_BACKEND=slurm_rest) ---
# Full versioned base URL. The version must match what slurmrestd serves —
# check `curl <host>:6820/openapi/v3 | grep -o 'v0\.0\.[0-9]*' | sort -u`.
# SLURM_REST_URL=http://titan:6820/slurm/v0.0.42

# Token from `scontrol token lifespan=<seconds>`. THESE EXPIRE (30 min by
# default). slurmrestd answers 511 once it dies; the scheduler reports "cluster
# unavailable" and pauses rather than concluding every job died — but it does
# pause. Pick a renewal mode below.
# SLURM_JWT=

# --- Token renewal (SLURM_TOKEN_MODE) ---
#
#   static   Use SLURM_JWT as-is. Simplest; expires.
#
#   file     Read from SLURM_TOKEN_FILE, refreshed by cron / a systemd timer /
#            a Kubernetes secret. SAFEST: the scheduler holds only a token,
#            never a credential that can mint more tokens.
#              */20 * * * * ssh titan scontrol token lifespan=3600 > /run/slurm.token
#
#   command  Run a command that prints `SLURM_JWT=...`. Renewed automatically
#            before expiry, and again on the spot if a token dies early.
#
# SLURM_TOKEN_MODE=static
# SLURM_TOKEN_FILE=/run/secrets/slurm.token
# SLURM_TOKEN_COMMAND=/usr/local/bin/get-slurm-token.sh
#
# Renew this long before the token's own `exp` claim:
# SLURM_TOKEN_REFRESH_MARGIN_SECONDS=300
# SLURM_TOKEN_TIMEOUT_SECONDS=30

# --- SSH recipe for SLURM_TOKEN_MODE=command ---
# Builds: ssh <user>@<host> scontrol token lifespan=<n>
#
# SECURITY: this key can mint Slurm tokens. On the token host, pin it to a
# forced command in ~/.ssh/authorized_keys so a stolen key cannot get a shell:
#
#   command="scontrol token lifespan=3600",no-port-forwarding,no-agent-forwarding,\
#   no-pty,no-X11-forwarding ssh-ed25519 AAAAC3Nza... scheduler-token-renewal
#
# With a forced command the remote ignores our arguments, so set
# SLURM_TOKEN_LIFESPAN_SECONDS to match what you pinned there.
#
# Host key checking stays ON: someone impersonating the host could hand us a
# token pointing at their own slurmrestd. Populate known_hosts with:
#   ssh-keyscan titan > secrets/known_hosts
#
# SLURM_TOKEN_SSH_HOST=titan
# SLURM_TOKEN_SSH_USER=svc-slurm-tokens
# SLURM_TOKEN_SSH_KEY=/run/secrets/slurm_token_key
# SLURM_TOKEN_SSH_KNOWN_HOSTS=/run/secrets/known_hosts
# SLURM_TOKEN_LIFESPAN_SECONDS=3600

# Account jobs are submitted as. Set this if the JWT belongs to a privileged
# user (e.g. root) — otherwise jobs run as the token's owner.
# SLURM_REST_USER=svc-llm

# SLURM_REST_TIMEOUT_SECONDS=30
# SLURM_REST_VERIFY_TLS=true

# --- High availability ---
# With HA on, every instance serves proxy traffic but only the leader runs the
# background workers (two instances submitting for one booking would
# double-submit). Requires a shared database — i.e. Postgres, not SQLite.
# HA_ENABLED=false

# DB (Local file by default for ease of use)
DATABASE_URL=sqlite:///./router.db
# Postgres, required for HA_ENABLED=true:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/llm_scheduler

# Slurm Settings (Leave empty to detect defaults)
SLURM_PARTITION=
SLURM_ACCOUNT=
SLURM_QOS=
SLURM_NODELIST=
SLURM_CPUS_PER_TASK=16

# Slurm email notifications (optional — leave SLURM_MAIL_USER empty to disable)
# SLURM_MAIL_USER=your-email@example.com
# SLURM_MAIL_TYPE=FAIL,END,TIME_LIMIT

# ── Logs ──────────────────────────────────────────────────────────────────
# Two different directories, because two different machines write them.
#
# VLLM_LOG_DIR is OURS: lifecycle.log, written by this process. Local is fine.
VLLM_LOG_DIR=./logs

# JOB_LOG_DIR is where SLURM writes each job's stdout/stderr. The COMPUTE NODE
# resolves this path, so it must exist cluster-wide on a shared filesystem —
# a container path such as /app/logs makes every job fail at launch, with no
# log to explain why. Leave empty to reuse VLLM_LOG_DIR (correct only when the
# router runs on the cluster's own filesystem).
#
#   JOB_LOG_DIR=/mnt/shared/llm-scheduler/logs
#
# It must be writable by the account the jobs run as (the JWT's owner), and it
# must already exist: Slurm will not create it.
# JOB_LOG_DIR=

# The same directory as seen FROM HERE, if it is mounted under another path
# (a container bind, a different NFS mountpoint). Only log viewing uses it.
# Empty means "same path the nodes use".
# JOB_LOG_DIR_LOCAL=

# Compose only: host directory bind-mounted to /app/logs for VLLM_LOG_DIR.
# ROUTER_LOG_DIR=./logs

# ── Apptainer images ──────────────────────────────────────────────────────
# The shared directory compute nodes read .sif images from. Mount it here too:
# the images UI lists and deletes through the filesystem, and without it says
# so rather than showing an empty list. Empty disables image management.
#
#   APPTAINER_IMAGE_DIR=/mnt/shared/llm-scheduler/images
# APPTAINER_IMAGE_DIR=

# Working area for `apptainer build` — unpacked layers are several times the
# size of the finished .sif. Empty means <images>/../build-tmp, next to the
# images directory (typically NFS, which makes layer unpacking slow). The
# build job cleans its cache/tmp up on exit, so pointing this at fast
# node-local disk is safe — it will not accumulate across builds.
#
# Pointing it at node-local disk also changes *where the image is squashed*:
# on a separate filesystem the job builds the .sif here and copies the
# finished file across at the end, so the shared filesystem takes one
# sequential write instead of every write mksquashfs makes. That means this
# directory must have room for the blob cache, the unpacked rootfs AND the
# image — budget roughly 5x the .sif.
#
# Do NOT point this at a RAM-backed /tmp: on some nodes /tmp is a tmpfs, and
# an 8 GB image would then be built in RAM.
# IMAGE_BUILD_SCRATCH=

# IMAGE_BUILD_TEMPLATE_PATH=./templates/apptainer_build.sh
# IMAGE_BUILD_TIME_LIMIT=02:00:00
# IMAGE_BUILD_CPUS=8

# Credentials for a private registry (e.g. nvcr.io). These reach the build job
# through its environment, readable by the account the jobs run as.
# IMAGE_REGISTRY_USERNAME=
# IMAGE_REGISTRY_PASSWORD=

VLLM_API_KEY=secret

# Read-only API key for external schedule viewers (e.g., dashboards, status pages).
# Clients pass this via Authorization: Bearer <key> or ?token=<key>
# Leave empty to disable the public schedule API entirely.
SCHEDULE_API_KEY=

# vLLM job health waiting and retry behavior (fail fast + one retry)
VLLM_HEALTH_TIMEOUT_SECONDS=800
VLLM_MAX_RETRIES=1
VLLM_RETRY_DELAY_SECONDS=10

# Templates
SBATCH_TEMPLATE_PATH=./templates/vllm_job.sh

TOTAL_GPUS=8

# Logic
ALLOW_ON_DEMAND_START=false
